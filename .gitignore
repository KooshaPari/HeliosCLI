__pycache__/
target/
node_modules/
deploy/.env
# insta snapshot test artifacts (regenerated on each run)
*.snap.new
*.snap.d

# Bazel convenience symlinks and per-user config. Bazel creates bazel-bin,
# bazel-out and bazel-testlogs in the workspace root on every build, and
# .bazelrc try-imports user.bazelrc; without these the check-clean-worktree
# gate reports the worktree as dirty after any build that gets past loading.
bazel-*
user.bazelrc

# CI scratch dirs. The v8-canary jobs stage release pairs into dist/ and the
# windows source jobs check denoland/rusty_v8 out into upstream-rusty-v8/;
# both gate on check-clean-worktree with the checkout as the worktree root.
dist/
/upstream-rusty-v8/
